---
// Scène jaune qui porte la capture d'un projet.
// Sans capture, affiche un cadre vide clairement marqué « à ajouter ».
interface Props {
  title: string;
  image?: string;
  imageAlt?: string;
  url?: string;
}

const { title, image, imageAlt, url } = Astro.props;
const host = url ? new URL(url).host : null;
---

<figure class="stage">
  <div class="window">
    <div class="window-bar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      {host && <span class="address">{host}</span>}
    </div>
    {
      image ? (
        <img
          src={image}
          alt={imageAlt ?? `Capture d’écran de ${title}`}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="empty">
          <strong>{title}</strong>
          <span>Capture d’écran à ajouter</span>
        </div>
      )
    }
  </div>
</figure>

<style>
  .stage {
    margin: 0;
    padding: clamp(1.25rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-accent);
  }

  .window {
    overflow: hidden;
    border: 1px solid rgb(21 23 28 / 0.9);
    border-bottom: 0;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--color-bg);
    box-shadow: var(--shadow-md);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .dots {
    display: flex;
    gap: 0.35rem;
  }

  .dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #c9c9c3;
  }

  .address {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .empty {
    display: grid;
    aspect-ratio: 16 / 10;
    place-content: center;
    gap: 0.25rem;
    padding: var(--space-lg);
    background: repeating-linear-gradient(
      -45deg,
      var(--color-bg) 0 14px,
      var(--color-surface) 14px 15px
    );
    text-align: center;
  }

  .empty strong {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    letter-spacing: -0.02em;
  }

  .empty span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
