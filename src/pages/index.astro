---
import { getCollection } from "astro:content";
import ButtonLink from "../components/common/ButtonLink.astro";
import Container from "../components/common/Container.astro";
import ProjectStage from "../components/projects/ProjectStage.astro";
import {
  createWhatsAppUrl,
  formatPhoneForDisplay,
  siteConfig,
} from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicProjectTitle } from "../utils/projects";
import type { StructuredDataNode } from "../utils/structured-data";

const projects = (
  await getCollection(
    "projects",
    ({ data }) => data.published && data.visibility !== "private",
  )
).sort((a, b) => a.data.order - b.data.order);

const featured = projects.filter((project) => project.data.featured);
const others = projects.filter((project) => !project.data.featured);

const whatsappUrl = createWhatsAppUrl(siteConfig.contact.messages.project);
const displayPhone = formatPhoneForDisplay(siteConfig.phone);

const principles = [
  {
    title: "Je pars du terrain",
    text: "Je dirige moi-même Invincibo GSM. Je connais les commandes reçues sur WhatsApp, les comptes tenus dans un cahier et les clients qui paient en gourdes ou en dollars. Je construis pour ces réalités-là.",
  },
  {
    title: "Je livre par petites étapes",
    text: "Une fonctionnalité à la fois, testée, puis mise en ligne. Vous voyez le logiciel avancer chaque semaine au lieu d’attendre une grande livraison.",
  },
  {
    title: "Je reste après la mise en ligne",
    text: "Je ne disparais pas après la livraison : j’assure l’hébergement, les sauvegardes et les évolutions demandées par les utilisateurs.",
  },
] as const;

const stack = [
  "Node.js",
  "Express",
  "React",
  "Astro",
  "MySQL",
  "PostgreSQL / Supabase",
  "Render",
  "Cloudflare",
  "Hostinger",
] as const;

const homepageStructuredData = [
  {
    "@type": "WebSite",
    "@id": `${siteConfig.domain}/#website`,
    url: siteConfig.domain,
    name: siteConfig.name,
    inLanguage: siteConfig.locale,
  },
  {
    "@type": "Person",
    "@id": `${siteConfig.domain}/#person`,
    name: siteConfig.founder.name,
    jobTitle: siteConfig.founder.role,
    url: siteConfig.domain,
    description: siteConfig.description,
    telephone: siteConfig.phone,
    email: siteConfig.email,
    knowsLanguage: ["fr", "ht"],
  },
] satisfies StructuredDataNode[];
---

<BaseLayout
  home
  title={`${siteConfig.name} — Développeur web en Haïti`}
  description={siteConfig.description}
  canonical={siteConfig.domain}
  structuredData={homepageStructuredData}
>
  <section class="hero">
    <Container>
      <div class="hero-top">
        <img
          class="portrait"
          src={siteConfig.founder.photo}
          alt={`Portrait de ${siteConfig.founder.name}`}
          width="480"
          height="480"
          fetchpriority="high"
        />
        <p class="hero-role">Développeur web en Haïti</p>
      </div>
      <h1>Laveniel Séjour</h1>
      <div class="hero-bottom">
        <p class="hero-lead">
          Je construis les logiciels de gestion d’entreprises qui tournaient sur
          WhatsApp, Excel et des cahiers : une caisse d’épargne, une boutique de
          téléphones, des techniciens GSM.
        </p>
        <div class="hero-actions">
          <ButtonLink href={whatsappUrl} external
            >Écrire sur WhatsApp</ButtonLink
          >
          <ButtonLink href="#projets" variant="secondary"
            >Voir les projets</ButtonLink
          >
        </div>
      </div>
    </Container>
  </section>

  <section id="projets" class="projects" aria-labelledby="projets-titre">
    <Container>
      <h2 id="projets-titre">Projets</h2>

      {
        featured.map((project) => {
          const title = getPublicProjectTitle(project.data);
          return (
            <article class="project">
              <ProjectStage
                title={title}
                image={project.data.coverImage}
                imageAlt={project.data.coverImageAlt}
                url={project.data.liveUrl}
              />
              <div class="project-text">
                <p class="project-category">{project.data.category}</p>
                <h3>{title}</h3>
                <p class="project-summary">{project.data.summary}</p>

                <dl class="project-facts">
                  {project.data.challenge && (
                    <div>
                      <dt>Le problème</dt>
                      <dd>{project.data.challenge}</dd>
                    </div>
                  )}
                  {project.data.solution && (
                    <div>
                      <dt>Ce que j’ai construit</dt>
                      <dd>{project.data.solution}</dd>
                    </div>
                  )}
                </dl>

                <ul class="project-capabilities">
                  {project.data.capabilities.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>

                {project.data.technologies && (
                  <p class="project-stack">
                    {project.data.technologies.join(", ")}
                  </p>
                )}

                <p class="project-status">
                  <span class="status-dot" aria-hidden="true" />
                  {project.data.statusLabel}
                  {project.data.liveUrl && (
                    <a
                      href={project.data.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {new URL(project.data.liveUrl).host}
                    </a>
                  )}
                </p>
              </div>
            </article>
          );
        })
      }

      {
        others.length > 0 && (
          <div class="others">
            <h3 class="others-title">Autres projets</h3>
            <ul>
              {others.map((project) => (
                <li>
                  {project.data.coverImage && (
                    <img
                      class="others-image"
                      src={project.data.coverImage}
                      alt={project.data.coverImageAlt ?? ""}
                      width="1366"
                      height="607"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <h4>{getPublicProjectTitle(project.data)}</h4>
                  <p>{project.data.summary}</p>
                  <p class="others-status">{project.data.statusLabel}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </Container>
  </section>

  <section id="travail" class="work" aria-labelledby="travail-titre">
    <Container>
      <h2 id="travail-titre">Façon de travailler</h2>
      <div class="principles">
        {
          principles.map((principle) => (
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </div>
          ))
        }
      </div>
      <div class="stack">
        <h3>Outils que j’utilise</h3>
        <ul>{stack.map((item) => <li>{item}</li>)}</ul>
      </div>
    </Container>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-titre">
    <Container>
      <h2 id="contact-titre">Un logiciel à construire&nbsp;? Parlons-en.</h2>
      <p>
        Décrivez-moi votre activité et ce qui vous fait perdre du temps. Je
        réponds en français ou en créole.
      </p>
      <div class="contact-actions">
        <ButtonLink href={whatsappUrl} external size="lg"
          >Écrire sur WhatsApp</ButtonLink
        >
        <a class="contact-phone" href={`tel:${siteConfig.phone}`}
          >{displayPhone}</a
        >
        <a class="contact-email" href={`mailto:${siteConfig.email}`}
          >{siteConfig.email}</a
        >
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  section {
    padding-block: var(--space-section);
  }

  h2 {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  /* Hero : le nom est l'image. */
  .hero {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(3rem, 7vw, 5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .portrait {
    width: clamp(4.5rem, 10vw, 7.5rem);
    height: auto;
    border-radius: 50%;
    background: var(--color-surface);
  }

  .hero-role {
    margin: 0;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  h1 {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    font-size: clamp(3.25rem, 13vw, 10.5rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .hero-bottom {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
  }

  .hero-lead {
    margin: 0;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.45;
    max-width: 34ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Projets */
  .project {
    display: grid;
    gap: var(--space-xl);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-text);
  }

  .project-category {
    margin-bottom: var(--space-xs);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .project h3 {
    margin-bottom: var(--space-md);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .project-summary {
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .project-facts {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .project-facts dt {
    font-weight: 700;
  }

  .project-facts dd {
    margin: 0.15rem 0 0;
    color: var(--color-text-muted);
  }

  .project-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;
  }

  .project-capabilities li {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.875rem;
  }

  .project-stack {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .project-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0;
    font-weight: 700;
  }

  .status-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent-deep);
  }

  .project-status a {
    color: var(--color-link);
    font-weight: 500;
  }

  .others {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-text);
  }

  .others-title {
    margin-bottom: var(--space-lg);
    font-size: 1.25rem;
  }

  .others ul {
    display: grid;
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .others-image {
    width: 100%;
    height: auto;
    margin-bottom: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .others h4 {
    margin: 0 0 var(--space-xs);
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .others p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .others .others-status {
    margin-top: var(--space-xs);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
  }

  /* Façon de travailler */
  .work {
    background: var(--color-surface);
  }

  .principles {
    display: grid;
    gap: var(--space-xl);
  }

  .principles h3 {
    margin-bottom: var(--space-sm);
    font-size: 1.375rem;
  }

  .principles p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .stack {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .stack h3 {
    margin-bottom: var(--space-md);
    font-size: 1rem;
  }

  .stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.125rem;
    font-weight: 500;
  }

  /* Contact : le seul bloc entièrement jaune. */
  .contact {
    background: var(--color-accent);
  }

  .contact h2 {
    margin-bottom: var(--space-lg);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    max-width: 16ch;
  }

  .contact p {
    margin-bottom: var(--space-xl);
    font-size: 1.125rem;
    max-width: 46ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
  }

  .contact-phone,
  .contact-email {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .contact-email {
    font-size: clamp(1rem, 4.4vw, 1.25rem);
    overflow-wrap: break-word;
  }

  @media (min-width: 48rem) {
    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2xl);
    }

    .others ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .project :global(.stage) {
      order: 2;
    }

    .hero-bottom {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .project {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }
</style>
